<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Hub</title>
  <style>
    body {
      margin: 0;
      font-family: system-ui, sans-serif;
      background: #121218;
      color: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      text-align: center;
    }
    h1 { color: #ff5c8a; margin-bottom: 10px; }
    form { display: flex; gap: 8px; margin: 20px 0; width: 90%; max-width: 450px; }
    input {
      flex: 1; padding: 12px 16px; border-radius: 10px;
      border: none; font-size: 16px; outline: none;
    }
    button {
      padding: 12px 20px; border-radius: 10px; border: none;
      background: #ff5c8a; color: white; font-weight: bold; cursor: pointer;
    }
    .links { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .card {
      background: #1e1e28; padding: 14px 20px; border-radius: 10px;
      color: #fff; text-decoration: none; font-weight: 500;
    }
    .card:hover { background: #2a2a38; }
  </style>
</head>
<body>
  <h1>Mobs Mod</h1>
  <form action="https://duckduckgo.com" method="GET">
    <input type="text" name="q" placeholder="Search the web..." required>
    <button type="submit">Go</button>
  </form>
  <div class="links">
    <a class="card" href="https://duckduckgo.com">DuckDuckGo</a>
    <a class="card" href="https://wikipedia.org">Wikipedia</a>
  </div>
</body>
</html>
